---
import Base from '../layouts/Base.astro';
---

<Base title="Legal information. Nomoro" description="Company details for Nomoro BV.">
  <section class="wrap pt-12 pb-24 lg:pt-24 lg:pb-40">
    <div class="grid grid-cols-1 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-start-3 lg:col-span-7 flex flex-col gap-6 body">
        <p class="eyebrow">Legal information</p>
        <h1 class="h1">Nomoro BV</h1>
        <dl class="pt-4">
          {
            [
              ['Registered office', 'E.J. Van Gansenstraat 24, 2260 Westerlo, Belgium'],
              ['Company number', 'BE 1032.643.291 (RPR Antwerpen, division Turnhout)'],
              ['VAT', 'BE 1032.643.291'],
              ['Email', 'hello@nomoro.be'],
              ['Responsible for content', 'Jelle Eysermans'],
            ].map(([k, v]) => (
              <div class="grid grid-cols-1 gap-1 border-t border-stone py-4 sm:grid-cols-12 sm:gap-6">
                <dt class="small text-steel sm:col-span-4">{k}</dt>
                <dd class="sm:col-span-8">{v}</dd>
              </div>
            ))
          }
        </dl>
        <hr class="rule" />
        <h2 class="h3 pt-6">Editorial independence</h2>
        <p>
          Nomoro does not accept payment or commission for coverage. Where a maker has lent or given us an object
          for testing, the article says so in its first paragraph. Objects we sell are judged by the same twelve
          tests as objects we don’t.
        </p>
        <h2 class="h3 pt-6">Copyright</h2>
        <p>
          Text and photographs on this site are by Nomoro unless credited otherwise. Ask before reusing them;
          we usually say yes.
        </p>
      </div>
    </div>
  </section>
</Base>
