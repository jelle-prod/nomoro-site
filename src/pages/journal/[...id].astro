---
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';

export async function getStaticPaths() {
  const entries = await getCollection('journal', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);

const all = (await getCollection('journal', ({ data }) => !data.draft))
  .filter((e) => e.id !== entry.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const related =
  entry.data.related.length > 0
    ? all.filter((e) => entry.data.related.includes(e.id))
    : all.slice(0, 3);

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const minutes = entry.data.readingMinutes ?? Math.max(2, Math.round((entry.body?.split(/\s+/).length ?? 0) / 220));
const og = entry.data.hero ? (await getImage({ src: entry.data.hero, width: 1200, format: 'jpg' })).src : undefined;
---

<Base
  title={`${entry.data.title} Nomoro`}
  description={entry.data.excerpt}
  image={og}
  article={{ published: entry.data.date, author: entry.data.author }}
>
  <!-- Header, offset two columns -->
  <header class="wrap pt-12 pb-16 lg:pt-24 lg:pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-start-3 lg:col-span-8 flex flex-col gap-8">
        <div class="flex flex-wrap gap-x-6 gap-y-2 eyebrow">
          <span>{entry.data.category}</span>
          <span>{fmt(entry.data.date)}</span>
          <span>{minutes} min read</span>
        </div>
        <h1 class="h1">{entry.data.title}</h1>
        <p class="standfirst text-steel">{entry.data.standfirst}</p>
      </div>
    </div>
  </header>

  {
    entry.data.hero && (
      <figure class="wrap flex flex-col gap-3">
        <Image
          src={entry.data.hero}
          alt={entry.data.heroAlt ?? ''}
          widths={[640, 1280, 2560]}
          sizes="(min-width: 90rem) 1280px, 100vw"
          class="aspect-[4/5] sm:aspect-[16/9] w-full object-cover"
          loading="eager"
        />
        {entry.data.heroCaption && <figcaption class="small text-steel">{entry.data.heroCaption}</figcaption>}
      </figure>
    )
  }

  <!-- Body in the 736 reading column, offset two columns -->
  <div class="wrap py-16 lg:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-start-3 lg:col-span-7 prose">
        <Content />

        <!-- Closing question, part of every article -->
        <aside class="mt-16 pt-10 border-t border-stone flex flex-col gap-4" aria-labelledby="closing-q">
          <h2 id="closing-q" class="h3 !mt-0">What have you simply learned to live with?</h2>
          <p class="body text-steel">
            Tell us the awkward movement, the extra step, the object that needs another object. Replies go to a
            person, not a form.
          </p>
          <a
            href={`mailto:hello@nomoro.be?subject=An%20observation%20after%20reading%20${encodeURIComponent(entry.data.title)}`}
            class="link body"
            onclick="window.plausible && window.plausible('Observation')"
            >Share an observation →</a
          >
        </aside>
      </div>
    </div>
  </div>

  {
    related.length > 0 && (
      <section class="wrap pb-24" aria-labelledby="more-heading">
        <p id="more-heading" class="eyebrow">
          More from the journal
        </p>
        <hr class="rule mt-6" />
        {related.map((e) => (
          <>
            <ArticleRow entry={e} showImage={false} />
            <hr class="rule" />
          </>
        ))}
      </section>
    )
  }

  <Newsletter compact />
</Base>
