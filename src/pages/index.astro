---
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

/* Section 03 renders only once there are published articles. Never placeholders. */
const articles = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const [lead, ...rest] = articles;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  title="Nomoro. Good design should remove more than it adds."
  description="An independent design journal. We discover, question and celebrate everyday objects that make life simpler. Less to do. More to life."
>
  <!-- 01 Hero -->
  <section class="wrap pt-12 pb-24 lg:pt-24 lg:pb-40">
    <p class="eyebrow">Independent design journal.</p>
    <h1 class="display mt-8 lg:mt-10 lg:max-w-[1171px]">Good design should remove more than it adds.</h1>
    <div class="mt-10 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <p class="body-l lg:max-w-[628px]">
        We discover, question and celebrate everyday objects that make life simpler.
      </p>
      <a href="#journal" class="link body">Explore the journal ↓</a>
    </div>
    <!-- Hero photograph. Shot 1: a hand mid chore, real kitchen, daylight. -->
    <div class="mt-16 lg:mt-24 aspect-[4/5] sm:aspect-[16/9] placeholder" role="img" aria-label="Photograph to come: a hand mid chore in a real kitchen.">
      <span>Hero photograph, Saturday. A hand mid chore. The observation, not a product.</span>
    </div>
  </section>

  <!-- 02 The paradox. Typographic, offset to the right of the grid. -->
  <section class="wrap section" aria-labelledby="paradox-heading">
    <div class="grid grid-cols-1 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-start-5 lg:col-span-8 flex flex-col gap-10">
        <h2 id="paradox-heading" class="h1">More isn’t always better.</h2>
        <div class="measure flex flex-col gap-6 body-l">
          <p>Every new object promises to make life easier.</p>
          <p>
            But it also asks something of us. A place to store it. Time to clean it. Another thing to
            maintain, repair or replace.
          </p>
          <p>We believe the best products do the opposite.</p>
          <p>
            They remove an unnecessary step. Make another object redundant. Or improve an ordinary
            moment so naturally that you wonder why it was ever different.
          </p>
        </div>
        <p class="h3">Less to do. More to life.</p>
      </div>
    </div>
  </section>

  <!-- 03 From the journal. Only when articles exist. -->
  {
    lead && (
      <section id="journal" class="wrap section" aria-labelledby="journal-heading">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
          <div class="flex flex-col gap-4">
            <p id="journal-heading" class="eyebrow">
              From the journal
            </p>
            <p class="body-l lg:max-w-[628px]">
              Observations on objects, habits and the little things we no longer question.
            </p>
          </div>
          <a href="/journal/" class="link body">
            Read the journal →
          </a>
        </div>
        <hr class="rule my-10 lg:my-16" />

        <article class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-6 lg:items-end">
          <a href={`/journal/${lead.id}/`} class="lg:col-span-7 block">
            {lead.data.hero ? (
              <Image
                src={lead.data.hero}
                alt={lead.data.heroAlt ?? ''}
                widths={[480, 736, 1472]}
                sizes="(min-width: 64rem) 736px, 100vw"
                class="aspect-[4/3] w-full object-cover"
              />
            ) : (
              <div class="aspect-[4/3] placeholder">
                <span>Lead image missing.</span>
              </div>
            )}
          </a>
          <div class="lg:col-span-5 flex flex-col gap-6">
            <p class="eyebrow">{lead.data.category}</p>
            <h3 class="h2">
              <a href={`/journal/${lead.id}/`}>{lead.data.title}</a>
            </h3>
            <p class="standfirst text-steel">{lead.data.standfirst}</p>
            <a href={`/journal/${lead.id}/`} class="link body">
              Read →
            </a>
          </div>
        </article>

        {rest.length > 0 && <hr class="rule mt-10 lg:mt-16" />}
        {rest.map((a) => (
          <>
            <article class="grid grid-cols-1 gap-6 py-10 lg:grid-cols-12 lg:gap-6 lg:items-start">
              <p class="eyebrow lg:col-span-2">{a.data.category}</p>
              <div class="lg:col-span-7 flex flex-col gap-4">
                <h3 class="h3">
                  <a href={`/journal/${a.id}/`}>{a.data.title}</a>
                </h3>
                <p class="body text-steel lg:max-w-[628px]">{a.data.excerpt}</p>
              </div>
              <a href={`/journal/${a.id}/`} class="lg:col-span-3 block">
                {a.data.hero && (
                  <Image
                    src={a.data.hero}
                    alt=""
                    widths={[302, 604]}
                    sizes="(min-width: 64rem) 302px, 100vw"
                    class="aspect-[3/2] w-full object-cover"
                  />
                )}
              </a>
            </article>
            <hr class="rule" />
          </>
        ))}
      </section>
    )
  }

  <!-- 04 Our approach -->
  <section class="wrap section" aria-labelledby="approach-heading">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-6">
      <h2 id="approach-heading" class="h2 lg:col-span-7">
        We don’t believe every good idea needs to be invented again.
      </h2>
      <div class="lg:col-span-5 flex flex-col gap-4 body-l">
        <p>Some remarkable objects already exist. They simply deserve to be discovered.</p>
        <p>Others have the right idea, but could be better.</p>
        <p>And sometimes, the right solution doesn’t exist yet.</p>
      </div>
    </div>
    <ul class="mt-16 lg:mt-24" role="list">
      {
        ['Discover.', 'Refine.', 'Invent.'].map((w) => (
          <li class="border-t border-stone py-5 lg:py-6">
            <span class="display">{w}</span>
          </li>
        ))
      }
    </ul>
    <hr class="rule" />
    <div class="mt-10 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <p class="body-l lg:max-w-[628px]">Three ways of doing one thing: making everyday life a little better.</p>
      <a href="/belief/" class="link body">Our belief →</a>
    </div>
  </section>

  <!-- 05 Invitation to observe. The one inverted section. -->
  <section class="inverted" aria-labelledby="observe-heading">
    <div class="wrap section grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-6">
      <h2 id="observe-heading" class="h1 lg:col-span-7">What have you simply learned to live with?</h2>
      <div class="lg:col-span-5 flex flex-col gap-6">
        <p class="body-l">The awkward movement. The extra step. The object that needs another object.</p>
        <p class="body-l text-steel">We’re collecting the little frustrations people have stopped questioning.</p>
        <a
          href="mailto:hello@nomoro.be?subject=An%20observation"
          class="link body"
          onclick="window.plausible && window.plausible('Observation')"
          >Share an observation →</a
        >
      </div>
    </div>
  </section>

  <!-- 06 Newsletter -->
  <Newsletter />
</Base>
