---
import Base from '../layouts/Base.astro';
---

<Base title="Nomoro — Got it" description="Your teardown request is in.">
  <main class="mx-auto max-w-3xl px-6">
    <section class="pt-20 pb-24 sm:pt-28 sm:pb-32">
      <h1 class="display measure">Got it.</h1>
      <p class="lede measure mt-6" style="color: var(--ink-soft)">
        Your teardown comes from jelle@nomoro.be. Days, not weeks.
      </p>
      <p class="mt-9">
        <a class="btn" href="/">Back to the site</a>
      </p>
    </section>
  </main>
</Base>
