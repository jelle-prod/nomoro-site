---
/**
 * A journal entry as a rule separated row: category and date left,
 * title and excerpt middle, small image right. Used on the journal
 * index and on article pages under "More from the journal".
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'journal'>;
  showImage?: boolean;
}
const { entry, showImage = true } = Astro.props;
const href = `/journal/${entry.id}/`;
const date = entry.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<article class="grid grid-cols-1 gap-5 py-10 lg:grid-cols-12 lg:gap-6 lg:items-start">
  <div class="lg:col-span-2 flex flex-col gap-2">
    <p class="eyebrow">{entry.data.category}</p>
    <p class="small text-steel">{date}</p>
  </div>
  <div class={showImage ? 'lg:col-span-7 flex flex-col gap-3' : 'lg:col-span-9 flex flex-col gap-3'}>
    <h3 class="h3"><a href={href}>{entry.data.title}</a></h3>
    <p class="body text-steel lg:max-w-[628px]">{entry.data.excerpt}</p>
  </div>
  {
    showImage && entry.data.hero && (
      <a href={href} class="lg:col-span-3 block">
        <Image
          src={entry.data.hero}
          alt=""
          widths={[302, 604]}
          sizes="(min-width: 64rem) 302px, 100vw"
          class="aspect-[3/2] w-full object-cover"
        />
      </a>
    )
  }
  {
    !showImage && (
      <a href={href} class="lg:col-span-1 link body lg:justify-self-end">
        Read →
      </a>
    )
  }
</article>
