---
/**
 * Section 06. A quiet close with a single email field.
 * Provider: Buttondown by default. Set PUBLIC_NEWSLETTER_ACTION in .env to the
 * provider's form endpoint, e.g.
 *   https://buttondown.com/api/emails/embed-subscribe/nomoro
 * Until it is set, the form posts to /subscribe which does not exist yet,
 * so nothing is collected by accident.
 */
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const action = import.meta.env.PUBLIC_NEWSLETTER_ACTION ?? '/subscribe';
---

<section class="wrap section" aria-labelledby="newsletter-heading">
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-6">
    <div class="lg:col-span-7 flex flex-col gap-6">
      <h2 id="newsletter-heading" class="h2">A little less, occasionally.</h2>
      {
        compact ? (
          <p class="body-l">Sent when we have something worth sharing.</p>
        ) : (
          <p class="body-l lg:max-w-[628px]">
            Notes on thoughtful design, overlooked frustrations and remarkable everyday objects. Sent
            when we have something worth sharing.
          </p>
        )
      }
    </div>
    <form
      class="lg:col-span-5 flex flex-col gap-4"
      method="post"
      action={action}
      target="_blank"
      data-plausible-form
    >
      <label class="sr-only" for="newsletter-email">Email address</label>
      <div class="field-line body-l">
        <input
          id="newsletter-email"
          type="email"
          name="email"
          autocomplete="email"
          inputmode="email"
          required
          placeholder="Your email"
        />
        <button type="submit" class="body">Subscribe to the Nomoro letter →</button>
      </div>
      <p class="small text-steel">No noise. No unnecessary emails.</p>
    </form>
  </div>
</section>

<script>
  // Count the submit as a Plausible goal. The provider handles confirmation.
  document.querySelectorAll('form[data-plausible-form]').forEach((f) => {
    f.addEventListener('submit', () => {
      // @ts-ignore
      window.plausible?.('Subscribe');
    });
  });
</script>
